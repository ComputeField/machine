# Normally written by `computefield-machine pair`; only advanced container
# deployments need to set the broker URL manually.
MACHINE_BROKER_URL=wss://computefield.net/ws/machine
COMPUTEFIELD_API_URL=https://computefield.net
MACHINE_ID=
MACHINE_COMPUTE_MODE=auto
COMPUTEFIELD_BWRAP=
ALLOW_FOREIGN_WORKLOADS=false
HARDWARE_STATS_INTERVAL=5
SHARD_CACHE_MAX_MB=8192
SPEEDTEST_PAYLOAD_MB=8
CUDA_VISIBLE_DEVICES=0
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
