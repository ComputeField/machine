set -Eeuo pipefail

prefix="${HOME}/Library/Application Support/ComputeField Machine"
export MACHINE_IDENTITY_FILE="${MACHINE_IDENTITY_FILE:-$prefix/identity.json}"
export MACHINE_WORK_DIR="${MACHINE_WORK_DIR:-$prefix/work}"
export MACHINE_ISOLATION_MODE="${MACHINE_ISOLATION_MODE:-sandbox}"

label="com.computefield.machine"
domain="gui/$(id -u)"
plist="${HOME}/Library/LaunchAgents/${label}.plist"

start_agent() {
  if launchctl print "${domain}/${label}" >/dev/null 2>&1; then
    launchctl kickstart -k "${domain}/${label}"
  else
    launchctl bootstrap "$domain" "$plist"
  fi
}

stop_agent() {
  if launchctl print "${domain}/${label}" >/dev/null 2>&1; then
    launchctl bootout "${domain}/${label}"
  fi
}

case "${1:-}" in
  start)
    start_agent
    echo "ComputeField Machine started."
    exit 0
    ;;
  stop)
    stop_agent
    echo "ComputeField Machine stopped."
    exit 0
    ;;
  restart)
    stop_agent
    start_agent
    echo "ComputeField Machine restarted."
    exit 0
    ;;
  pair|sharing)
    if "$prefix/venv/bin/computefield-machine" "$@"; then
      start_agent
      echo "ComputeField Machine is running."
      exit 0
    else
      status=$?
      exit "$status"
    fi
    ;;
  unpair)
    if "$prefix/venv/bin/computefield-machine" "$@"; then
      stop_agent
      exit 0
    else
      status=$?
      exit "$status"
    fi
    ;;
esac

exec "$prefix/venv/bin/computefield-machine" "$@"
