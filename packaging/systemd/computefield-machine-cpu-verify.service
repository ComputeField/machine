[Unit]
Description=Verify ComputeField Machine CPU sandbox

[Service]
Type=oneshot
User=computefield-machine-cpu
Group=computefield-machine-cpu
Environment=MACHINE_IDENTITY_FILE=/var/lib/computefield-machine-cpu/identity.json
Environment=MACHINE_WORK_DIR=/var/lib/computefield-machine-cpu/work
Environment=MACHINE_ISOLATION_MODE=sandbox
Environment=MACHINE_COMPUTE_MODE=cpu
Environment=CUDA_VISIBLE_DEVICES=
Environment=COMPUTEFIELD_BWRAP=/opt/computefield-machine-cpu/bin/bwrap
EnvironmentFile=-/etc/computefield-machine-cpu/environment
ExecStart=/opt/computefield-machine-cpu/verify-venv/bin/computefield-machine doctor
TasksMax=1024
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/computefield-machine-cpu
RestrictSUIDSGID=true
LockPersonality=true
PrivateDevices=true
PrivateMounts=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=~@raw-io @reboot @swap
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0077
