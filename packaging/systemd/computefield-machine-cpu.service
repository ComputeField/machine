[Unit]
Description=ComputeField Machine (CPU)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=computefield-machine-cpu
Group=computefield-machine-cpu
Environment=MACHINE_IDENTITY_FILE=/var/lib/computefield-machine-cpu/identity.json
Environment=MACHINE_WORK_DIR=/var/lib/computefield-machine-cpu/work
Environment=MACHINE_ISOLATION_MODE=sandbox
Environment=MACHINE_COMPUTE_MODE=cpu
Environment=CUDA_VISIBLE_DEVICES=
EnvironmentFile=-/etc/computefield-machine-cpu/environment
ExecStart=/opt/computefield-machine-cpu/venv/bin/computefield-machine run
Restart=always
RestartSec=5
TasksMax=1024
MemoryHigh=90%
MemoryMax=95%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/var/lib/computefield-machine-cpu
RestrictSUIDSGID=true
LockPersonality=true
PrivateDevices=true
PrivateMounts=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectHostname=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=~@raw-io @reboot @swap
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
