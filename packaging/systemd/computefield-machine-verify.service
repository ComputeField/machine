[Unit]
Description=Verify ComputeField Machine GPU sandbox

[Service]
Type=oneshot
User=computefield-machine
Group=computefield-machine
Environment=MACHINE_IDENTITY_FILE=/var/lib/computefield-machine/identity.json
Environment=MACHINE_WORK_DIR=/var/lib/computefield-machine/work
Environment=MACHINE_ISOLATION_MODE=sandbox
Environment=COMPUTEFIELD_BWRAP=/opt/computefield-machine/bin/bwrap
EnvironmentFile=-/etc/computefield-machine/environment
ExecStart=/opt/computefield-machine/verify-venv/bin/computefield-machine doctor
TasksMax=1024
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/computefield-machine
RestrictSUIDSGID=true
LockPersonality=true
PrivateDevices=false
PrivateMounts=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=~@raw-io @reboot @swap
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=0077
