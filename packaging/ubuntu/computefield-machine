set -eu

case "$(basename "$0")" in
  computefield-machine-cpu)
    service_user="computefield-machine-cpu"
    service_name="computefield-machine-cpu.service"
    app_root="/opt/computefield-machine-cpu"
    state_root="/var/lib/computefield-machine-cpu"
    compute_mode="cpu"
    ;;
  *)
    service_user="computefield-machine"
    service_name="computefield-machine.service"
    app_root="/opt/computefield-machine"
    state_root="/var/lib/computefield-machine"
    compute_mode="auto"
    ;;
esac
binary="$app_root/venv/bin/computefield-machine"
identity="$state_root/identity.json"
work_dir="$state_root/work"
command_name="${1:-}"

case "$command_name" in
  doctor|pair|unpair|sharing|status)
    if [ "$(id -u)" -ne 0 ]; then
      command -v sudo >/dev/null 2>&1 || {
        echo "Run this command as root." >&2
        exit 1
      }
      exec sudo -- "$0" "$@"
    fi
    set +e
    if [ "$compute_mode" = "cpu" ]; then
      runuser -u "$service_user" -- env \
        MACHINE_IDENTITY_FILE="$identity" \
        MACHINE_WORK_DIR="$work_dir" \
        MACHINE_ISOLATION_MODE=sandbox \
        MACHINE_COMPUTE_MODE=cpu \
        CUDA_VISIBLE_DEVICES= \
        COMPUTEFIELD_BWRAP="$app_root/bin/bwrap" \
        "$binary" "$@"
    else
      runuser -u "$service_user" -- env \
        MACHINE_IDENTITY_FILE="$identity" \
        MACHINE_WORK_DIR="$work_dir" \
        MACHINE_ISOLATION_MODE=sandbox \
        MACHINE_COMPUTE_MODE=auto \
        COMPUTEFIELD_BWRAP="$app_root/bin/bwrap" \
        "$binary" "$@"
    fi
    status=$?
    set -e
    case "$command_name:$status" in
      pair:0|sharing:0)
        if ! systemctl restart "$service_name"; then
          echo "Machine settings were saved, but the service failed its startup checks." >&2
          echo "Inspect it with: journalctl -u $service_name -n 80 --no-pager" >&2
          exit 1
        fi
        ;;
      unpair:0)
        systemctl stop "$service_name"
        ;;
    esac
    exit "$status"
    ;;
  *)
    exec "$binary" "$@"
    ;;
esac
