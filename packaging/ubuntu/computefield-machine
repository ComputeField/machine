set -eu

service_user="computefield-machine"
binary="/opt/computefield-machine/venv/bin/computefield-machine"
identity="/var/lib/computefield-machine/identity.json"
work_dir="/var/lib/computefield-machine/work"
command_name="${1:-}"

case "$command_name" in
  doctor|pair|unpair|sharing|status)
    if [ "$(id -u)" -ne 0 ]; then
      command -v sudo >/dev/null 2>&1 || {
        echo "Run this command as root." >&2
        exit 1
      }
      exec sudo -- "$0" "$@"
    fi
    set +e
    runuser -u "$service_user" -- env \
      MACHINE_IDENTITY_FILE="$identity" \
      MACHINE_WORK_DIR="$work_dir" \
      MACHINE_ISOLATION_MODE=sandbox \
      "$binary" "$@"
    status=$?
    set -e
    case "$command_name:$status" in
      pair:0|unpair:0|sharing:0)
        systemctl restart computefield-machine.service
        ;;
    esac
    exit "$status"
    ;;
  *)
    exec "$binary" "$@"
    ;;
esac
